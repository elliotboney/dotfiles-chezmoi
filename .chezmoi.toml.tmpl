{{- $server := promptBoolOnce . "server" "Server machine? (true/false)" -}}
{{- $hostname := .chezmoi.hostname -}}
{{- $full_name := promptStringOnce . "full_name" "Full name (for git commits, etc)" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $github_username := promptStringOnce . "github_username" "GitHub username" -}}
{{/* work around unreliable hostname on darwin */}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname := output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}


# Encryption with key stored in Lastpass
encryption = "age"
[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1htl2m2qx7kzeg9ezqpq6cdfmtdgfyay9wvqv6n6qx3j0patvtd9s72l0j7"

[data]
    server = {{ $server }}
    hostname = {{ $hostname | quote }}
    full_name = {{ $full_name | quote }}  
    email = {{ $email | quote }}
    github_username = {{ $github_username | quote }}

# Git configuration
[git]
    autocommit = true
    autopush = false