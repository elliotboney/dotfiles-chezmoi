#!/usr/bin/env zsh
# unzip-thingi - Extract 3D print zips from Thingiverse/Printables
# Usage: unzip-thingi [--nodelete] <file.zip> [file2.zip ...]

setopt ERR_EXIT PIPE_FAIL

# ── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

# ── Flags ────────────────────────────────────────────────────────────────────
NODELETE=false
ZIP_FILES=()

for arg in "$@"; do
  case "$arg" in
    --nodelete) NODELETE=true ;;
    --help|-h)
      echo "Usage: unzip-thingi [--nodelete] <file.zip> [file2.zip ...]"
      echo ""
      echo "  Extracts each zip to a directory named after the zip file,"
      echo "  promotes the 'files/' subdirectory to root, and cleans up"
      echo "  images/, README.txt, and LICENSE.txt."
      echo ""
      echo "  --nodelete   Skip deletion of original zip (useful for testing)"
      exit 0
      ;;
    *.zip) ZIP_FILES+=("$arg") ;;
    *)
      echo "${RED}Unknown argument: $arg${RESET}" >&2
      exit 1
      ;;
  esac
done

if [[ ${#ZIP_FILES[@]} -eq 0 ]]; then
  echo "${RED}Error: No zip files specified.${RESET}" >&2
  echo "Usage: unzip-thingi [--nodelete] <file.zip> [file2.zip ...]" >&2
  exit 1
fi

# ── Process each zip ─────────────────────────────────────────────────────────
for zip_path in "${ZIP_FILES[@]}"; do

  # Resolve to absolute path
  zip_path="${zip_path:A}"

  if [[ ! -f "$zip_path" ]]; then
    echo "${RED}✗ Not found: $zip_path — skipping${RESET}" >&2
    continue
  fi

  # Derive output directory name from zip filename (strip .zip extension)
  zip_name="${zip_path:t}"          # basename
  dir_name="${zip_name:r}"          # remove extension
  dir_name="${dir_name//+/ }"       # replace plus signs with spaces
  dest_dir="${zip_path:h}/${dir_name}"  # same directory as zip

  echo "${CYAN}──────────────────────────────────────────${RESET}"
  echo "${CYAN}Processing: $zip_name${RESET}"
  echo "  → Destination: $dest_dir"

  # Create destination dir (fail if it already exists to avoid clobbering)
  if [[ -d "$dest_dir" ]]; then
    echo "${YELLOW}  ⚠ Directory already exists: $dest_dir — skipping${RESET}"
    continue
  fi
  mkdir -p "$dest_dir"

  # Extract
  echo "  → Extracting..."
  if ! unzip -q "$zip_path" -d "$dest_dir"; then
    echo "${RED}  ✗ Extraction failed for $zip_name${RESET}" >&2
    rm -rf "$dest_dir"
    continue
  fi

  # Promote files/ subdirectory contents to root
  files_dir="${dest_dir}/files"
  if [[ -d "$files_dir" ]]; then
    echo "  → Promoting files/ to root..."
    # Move everything inside files/ up to dest_dir
    for item in "${files_dir}"/*(DN); do
      mv "$item" "$dest_dir/"
    done
    rmdir "$files_dir"
  else
    echo "${YELLOW}  ⚠ No 'files/' subdirectory found — skipping promotion${RESET}"
  fi

  # Clean up images/, README.txt, LICENSE.txt
  echo "  → Cleaning up extras..."
  [[ -d "${dest_dir}/images" ]]      && rm -rf "${dest_dir}/images"      && echo "     deleted images/"
  [[ -f "${dest_dir}/README.txt" ]]  && rm -f  "${dest_dir}/README.txt"  && echo "     deleted README.txt"
  [[ -f "${dest_dir}/LICENSE.txt" ]] && rm -f  "${dest_dir}/LICENSE.txt" && echo "     deleted LICENSE.txt"

  # Delete original zip unless --nodelete
  if [[ "$NODELETE" == false ]]; then
    rm -f "$zip_path"
    echo "  → Deleted original zip"
  else
    echo "${YELLOW}  → --nodelete: kept original zip${RESET}"
  fi

  echo "${GREEN}  ✓ Done: $dir_name${RESET}"

done

echo "${CYAN}──────────────────────────────────────────${RESET}"
echo "${GREEN}All done.${RESET}"